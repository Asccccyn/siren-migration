NODE_ENV=development

SIREN_HOST=127.0.0.1
SIREN_PORT=8790

SIREN_PUBLIC_URL=https://voice.example.invalid
# 可选：仅当宿主明确要求固定 MCP App sandbox domain 时配置。
# Claude 的 claudemcpcontent.com 域名必须按“实际登记的 MCP connector URL”计算，不能猜。
SIREN_MCP_UI_DOMAIN=

SIREN_INTERNAL_TOKEN=

CORE_BASE_URL=
CORE_API_TOKEN=

ASR_PROVIDER=volc
ASYNC_TTS_PROVIDER=volc
REALTIME_TTS_PROVIDER=volc

VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

VOLC_TTS_CLUSTER=volcano_icl
VOLC_VOICE_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=siren-voice

DATABASE_PATH=./data/siren.db

FILLER_ENABLED=false

LOG_TRANSCRIPTS=false

CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 以下为可选项（均有默认值，见 packages/voice-core/src/config.ts）
# ---------------------------------------------------------------------------
SIREN_LOG_LEVEL=info

# Core Bridge 类型：mock | http（生产必须 http）
SIREN_CORE_BRIDGE=mock
CORE_TIMEOUT_MS=60000
# 开发用 Mock 回复文案（多句会走 sentence splitter）
MOCK_CORE_REPLY=嗯，我在听。你说，我慢慢回。

# 通话接线方显示名（身份映射：大脑换人只改这里，页面自动跟随）
SIREN_PEER_NAME=他

# 实时链路调优（规范要求参数全部配置化）
PARTIAL_GRACE_MS=450
CALL_TOKEN_TTL_S=120
# playback_drained ACK 超时（0 = 不等待客户端 ACK）
PLAYBACK_DRAIN_TIMEOUT_MS=4000
SIGNED_URL_TTL_S=3600
MAX_UPLOAD_MB=25
WS_MAX_PAYLOAD_MB=2
PREBUFFER_MAX_BYTES=1048576
JITTER_BUFFER_MS=350

# VAD（浏览器端 playground 使用，服务端只负责下发配置）
VAD_CONFIRM_MS=200
VAD_MIN_SPEECH_MS=400
VAD_END_SILENCE_MS=700
VAD_RMS_RATIO=4

# 安全
SIREN_SIGNING_SECRET=
SIREN_ALLOW_MOCK_IN_PRODUCTION=false

# 火山引擎端点（默认为官方地址，按需覆盖）
# 流式 ASR = 大模型 sauc v3（bigmodel 双向流式；可换 bigmodel_async / bigmodel_nostream）
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# 批量识别 = 大模型录音文件识别极速版 v3 flash（one-shot；成功码在响应头 X-Api-Status-Code=20000000）
VOLC_ASR_BATCH_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLC_ASR_BATCH_RESOURCE_ID=volc.bigasr.auc_turbo
# 批量 TTS（异步语音条 / 实时兜底）
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
# 实时 TTS = v3 双向流式 WebSocket（文本流式输入 / 音频流式输出）
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# 资源 ID 必须与音色类型匹配（互斥，见 docs/PROVIDERS.md「声音复刻」节）：
#   系统音色：seed-tts-2.0（豆包合成 2.0）/ volc.service_type.10029（1.0）
#   声音复刻音色（控制台复刻得到的 S_/saturn_ 开头 ID）：seed-icl-2.0（复刻 2.0）/ seed-icl-1.0（1.0，需开通 megatts）
# 不匹配时报 55000000（该资源下音色不存在）；资源未开通报 45000030 not granted
VOLC_TTS_RESOURCE_ID=volc.service_type.10029
VOLC_HTTP_TIMEOUT_MS=15000

# ElevenLabs
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 未配置 R2 时本地对象存储目录
LOCAL_OBJECT_DIR=./data/objects
